# Every variable, with defaults and detail: docs/deployment-es.md
# Empty value or commented out: whatever depends on it stays off.

# --- Discord ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_PREFIX=!
CONFIG_PERMISSION=Administrator
# Dev only: registers the slash commands instantly in one guild.
# DISCORD_GUILD_ID=

# --- Chat ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_SYSTEM_PROMPT=
MAX_INPUT_CHARS=4096
HISTORY_LIMIT=10
SESSION_TTL_SECONDS=3600
RATE_LIMIT_USER_PER_MIN=10
RATE_LIMIT_SESSION_PER_MIN=100

# --- Database ---
# SQLite needs no configuration. For the Mongo provider:
# MONGODB_URI=mongodb://localhost:27017/dagerbot

# --- Deployment ---
# Leave it out and the bot opens no socket at all. Set it only if the host needs
# a bound port to consider the deploy alive, or to point an uptime monitor at
# GET /health. PaaS that require it set PORT themselves.
# PORT=3000
