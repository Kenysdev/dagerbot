{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "src",
    "outDir": "dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": [
    "src/data/providers/sqlite.ts",
    "src/data/repositories/sqliteMemeRepository.ts",
    "src/data/repositories/sqliteSettingsRepository.ts"
  ]
}
